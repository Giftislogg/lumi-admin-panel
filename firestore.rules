rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Shared Hardened Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true &&
         request.auth.token.email == 'inammdletye1@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidBetaControl(data) {
      return data.enabled is bool &&
             data.blocking is bool &&
             data.minSupportedVersionCode is int &&
             data.minSupportedVersionCode >= 0 &&
             data.minSupportedVersionCode <= 100000 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 120 &&
             data.message is string &&
             data.message.size() >= 1 &&
             data.message.size() <= 600 &&
             data.buttonText is string &&
             data.buttonText.size() >= 1 &&
             data.buttonText.size() <= 50 &&
             data.redirectUrl is string &&
             data.redirectUrl.size() <= 500 &&
             (data.redirectUrl == '' || data.redirectUrl.matches('^https://.*')) &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidDailyPing(data) {
      return data.installId is string &&
             data.installId.size() >= 8 &&
             data.installId.size() <= 64 &&
             data.installId.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.dateKey is string &&
             data.dateKey.size() == 10 &&
             data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.deviceName is string &&
             data.deviceName.size() >= 1 &&
             data.deviceName.size() <= 120 &&
             data.androidVersion is string &&
             data.androidVersion.size() >= 1 &&
             data.androidVersion.size() <= 40 &&
             data.appVersion is string &&
             data.appVersion.size() >= 1 &&
             data.appVersion.size() <= 24 &&
             data.appVersionCode is int &&
             data.appVersionCode >= 1 &&
             data.appVersionCode <= 100000 &&
             data.isLowEndDevice is bool &&
             data.sessionCount is int &&
             data.sessionCount >= 1 &&
             data.sessionCount <= 100000 &&
             data.tracksPlayedCount is int &&
             data.tracksPlayedCount >= 0 &&
             data.tracksPlayedCount <= 1000000 &&
             data.usedFloatingOrb is bool &&
             data.usedTripleVolume is bool &&
             data.downloadsCount is int &&
             data.downloadsCount >= 0 &&
             data.downloadsCount <= 100000 &&
             data.cachedTrackCount is int &&
             data.cachedTrackCount >= 0 &&
             data.cachedTrackCount <= 100000 &&
             data.streamErrorCount is int &&
             data.streamErrorCount >= 0 &&
             data.streamErrorCount <= 100000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidBetaFeedback(data) {
      return data.installId is string &&
             data.installId.size() >= 8 &&
             data.installId.size() <= 64 &&
             data.installId.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.rating is int &&
             data.rating >= 1 &&
             data.rating <= 5 &&
             data.usefulness is string &&
             data.usefulness in ['very_useful', 'somewhat_useful', 'needs_work'] &&
             data.tags is list &&
             data.tags.size() <= 6 &&
             (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 48)) &&
             data.comment is string &&
             data.comment.size() <= 600 &&
             data.deviceName is string &&
             data.deviceName.size() >= 1 &&
             data.deviceName.size() <= 120 &&
             data.androidVersion is string &&
             data.androidVersion.size() >= 1 &&
             data.androidVersion.size() <= 40 &&
             data.appVersion is string &&
             data.appVersion.size() >= 1 &&
             data.appVersion.size() <= 24 &&
             data.appVersionCode is int &&
             data.appVersionCode >= 1 &&
             data.appVersionCode <= 100000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    // 3. Admins Directory
    match /admins/{adminUid} {
      allow get: if isSignedIn() && request.auth.uid == adminUid;
      allow list, create, update, delete: if isAdmin();
    }

    // 4. Remote Beta Control (Public GET for beta APK check, Admin-only write)
    match /app_config/{configId} {
      allow get: if isValidId(configId);
      allow list: if isAdmin();
      allow create: if isAdmin() &&
                       isValidId(configId) &&
                       incoming().keys().hasAll([
                         'enabled', 'blocking', 'minSupportedVersionCode',
                         'title', 'message', 'buttonText', 'redirectUrl', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'enabled', 'blocking', 'minSupportedVersionCode',
                         'title', 'message', 'buttonText', 'redirectUrl', 'updatedAt'
                       ]) &&
                       isValidBetaControl(incoming());
      allow update: if isAdmin() &&
                       isValidId(configId) &&
                       isValidBetaControl(incoming()) &&
                       incoming().keys().hasOnly([
                         'enabled', 'blocking', 'minSupportedVersionCode',
                         'title', 'message', 'buttonText', 'redirectUrl', 'updatedAt'
                       ]);
      allow delete: if isAdmin() && isValidId(configId);
    }

    // 5. Anonymous Daily Active Pings (Write/update same-day doc by testers, read/list strictly Admin)
    match /beta_daily_pings/{pingId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(pingId) &&
                       pingId == incoming().installId + '_' + incoming().dateKey &&
                       incoming().keys().hasAll([
                         'installId', 'dateKey', 'deviceName', 'androidVersion',
                         'appVersion', 'appVersionCode', 'isLowEndDevice',
                         'sessionCount', 'tracksPlayedCount', 'usedFloatingOrb',
                         'usedTripleVolume', 'downloadsCount', 'cachedTrackCount',
                         'streamErrorCount', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'installId', 'dateKey', 'deviceName', 'androidVersion',
                         'appVersion', 'appVersionCode', 'isLowEndDevice',
                         'sessionCount', 'tracksPlayedCount', 'usedFloatingOrb',
                         'usedTripleVolume', 'downloadsCount', 'cachedTrackCount',
                         'streamErrorCount', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidDailyPing(incoming());
      allow update: if isValidId(pingId) &&
                       isValidDailyPing(incoming()) &&
                       incoming().installId == existing().installId &&
                       incoming().dateKey == existing().dateKey &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'deviceName', 'androidVersion', 'appVersion', 'appVersionCode',
                         'isLowEndDevice', 'sessionCount', 'tracksPlayedCount',
                         'usedFloatingOrb', 'usedTripleVolume', 'downloadsCount',
                         'cachedTrackCount', 'streamErrorCount', 'updatedAt'
                       ]);
      allow delete: if isAdmin();
    }

    // 6. Anonymous In-App Beta Feedback & Star Ratings (Create-only by testers, read/delete strictly Admin)
    match /beta_feedback/{feedbackId} {
      allow get, list, update, delete: if isAdmin();
      allow create: if isValidId(feedbackId) &&
                       incoming().keys().hasAll([
                         'installId', 'rating', 'usefulness', 'tags', 'comment',
                         'deviceName', 'androidVersion', 'appVersion', 'appVersionCode', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'installId', 'rating', 'usefulness', 'tags', 'comment',
                         'deviceName', 'androidVersion', 'appVersion', 'appVersionCode', 'createdAt'
                       ]) &&
                       isValidBetaFeedback(incoming());
    }
  }
}
